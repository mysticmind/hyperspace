#!/usr/bin/env python3
"""Regenerate world.json - the globe's land geometry - from Natural Earth.

world.json is committed, so this is never run at runtime and never by
install.sh. It exists so the blob next to it is auditable: a reviewer can run
this and diff the result rather than take a 200KB array of numbers on trust.

    plugins/worldradio/world-build > plugins/worldradio/world.json

Source: Natural Earth 1:110m Admin 0 countries, which is public domain
(https://www.naturalearthdata.com/about/terms-of-use/). The upstream file is
840KB of 5-decimal coordinates, which is far more than a globe a few hundred
pixels wide can show, so it is simplified here:

  * Douglas-Peucker at 0.3 degrees, which is under a pixel at the zoom levels
    the panel offers and takes out ~85% of the points.
  * Rings smaller than 0.4 square degrees are dropped, EXCEPT when that would
    leave a country with no geometry at all - the small island states are
    exactly the ones a world radio wants you to be able to find.
  * Two decimals, ~1km. A third decimal costs 15% of the file for detail no
    projection here can resolve.

Coordinates are stored as ONE flat [lon, lat, lon, lat, ...] array per ring
rather than nested pairs: same numbers, no per-point brackets, and it is a
third smaller for a file that is mostly punctuation otherwise.
"""
import json
import sys
import urllib.request

URL = ("https://raw.githubusercontent.com/nvkelso/natural-earth-vector"
       "/master/geojson/ne_110m_admin_0_countries.geojson")

EPSILON = 0.3          # degrees, Douglas-Peucker
MIN_RING_AREA = 0.4    # square degrees of bounding box
PRECISION = 2


def simplify(points, epsilon):
    """Douglas-Peucker, iterative - a recursive one blows the stack on rings
    with thousands of points, and Russia has several."""
    if len(points) < 3:
        return points
    keep = [False] * len(points)
    keep[0] = keep[-1] = True
    stack = [(0, len(points) - 1)]
    while stack:
        start, end = stack.pop()
        ax, ay = points[start]
        bx, by = points[end]
        dx, dy = bx - ax, by - ay
        span = dx * dx + dy * dy
        worst, index = 0.0, -1
        for i in range(start + 1, end):
            px, py = points[i]
            if span == 0:
                d = (px - ax) ** 2 + (py - ay) ** 2
            else:
                # Perpendicular distance, squared, without the square root:
                # comparing against epsilon squared gives the same ordering.
                cross = dx * (ay - py) - (ax - px) * dy
                d = cross * cross / span
            if d > worst:
                worst, index = d, i
        if index >= 0 and worst > epsilon * epsilon:
            keep[index] = True
            stack.append((start, index))
            stack.append((index, end))
    return [p for p, k in zip(points, keep) if k]


def ring_area(points):
    lons = [p[0] for p in points]
    lats = [p[1] for p in points]
    return (max(lons) - min(lons)) * (max(lats) - min(lats))


def rings_of(geometry):
    kind = geometry.get("type")
    if kind == "Polygon":
        return [geometry["coordinates"][0]]        # outer ring only
    if kind == "MultiPolygon":
        return [polygon[0] for polygon in geometry["coordinates"]]
    return []


def main():
    with urllib.request.urlopen(URL, timeout=60) as response:
        data = json.load(response)

    countries = []
    for feature in data["features"]:
        properties = feature["properties"]
        # ISO_A2_EH, not ISO_A2: the plain field is "-99" for France, Norway
        # and a dozen others, and those are countries with radio stations.
        code = (properties.get("ISO_A2_EH") or properties.get("ISO_A2") or "").strip()
        name = properties.get("NAME_EN") or properties.get("NAME") or ""
        if not code or code == "-99" or len(code) != 2:
            continue

        simplified = []
        for ring in rings_of(feature["geometry"]):
            points = simplify([(float(x), float(y)) for x, y in ring], EPSILON)
            if len(points) < 4:
                continue
            simplified.append(points)
        if not simplified:
            continue

        big = [r for r in simplified if ring_area(r) >= MIN_RING_AREA]
        # Keep the largest ring regardless, so Malta and Singapore are still
        # on the globe and still clickable.
        kept = big or [max(simplified, key=ring_area)]

        flat = []
        for ring in kept:
            out = []
            previous = None
            for x, y in ring:
                point = (round(x, PRECISION), round(y, PRECISION))
                if point == previous:          # rounding collapses neighbours
                    continue
                previous = point
                out.extend(point)
            if len(out) >= 8:
                flat.append(out)
        if not flat:
            continue

        largest = max(kept, key=ring_area)
        lons = [p[0] for p in largest]
        lats = [p[1] for p in largest]
        countries.append({
            "c": code.upper(),
            "n": name,
            # Bounding-box centre of the largest ring. Not a true centroid,
            # and it does not need to be: it is where the globe spins to when
            # you pick a country, and "somewhere in the middle" is the spec.
            "o": [round((min(lons) + max(lons)) / 2, PRECISION),
                  round((min(lats) + max(lats)) / 2, PRECISION)],
            "p": flat,
        })

    countries.sort(key=lambda c: c["c"])
    json.dump({
        "source": "Natural Earth 1:110m Admin 0 countries (public domain)",
        "url": URL,
        "simplified": {"douglasPeucker": EPSILON, "minRingArea": MIN_RING_AREA,
                       "decimals": PRECISION},
        "countries": countries,
    }, sys.stdout, separators=(",", ":"))
    sys.stdout.write("\n")
    points = sum(len(r) // 2 for c in countries for r in c["p"])
    print(f"{len(countries)} countries, {points} points", file=sys.stderr)


if __name__ == "__main__":
    main()
