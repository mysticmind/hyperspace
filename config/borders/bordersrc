#!/bin/bash
# JankyBorders — a thin ring around the focused window only.
# Launched by `brew services start borders`; this file is executed by the
# daemon on startup and messages the options across.
#
# Colours come from the Alacritty theme: 0xff9580ff is the cursor purple,
# 0xff57c7ff is its blue. Omarchy's own is brighter — cyan into green,
# rgba(33ccffee)/rgba(00ff99ee) in Hyprland order, which is
# gradient(top_left=0xee33ccff,bottom_right=0xee00ff99) here — but against a
# dark terminal it shouts where this one just reads. For more punch without
# leaving the terminal palette, swap the blue end for the theme's magenta:
# gradient(top_left=0xff9580ff,bottom_right=0xffff6ac1)
#
# hidpi=on renders at native Retina resolution instead of a scaled 1x line.
# It is most of why this reads sharp — a crisp thin edge looks stronger than
# a soft thick one.
#
# style takes round, square or uniform — parsed by first letter only
# (style=%c in the binary), and `uniform` appears nowhere in the man page's
# OPTIONS, only in its NOMENCLATURE list. round is the one that matches each
# window: borders calls SLSWindowIteratorGetCornerRadii, a private SkyLight
# call returning that window's ACTUAL corner radii, so the ring follows the
# real shape instead of a guess. square forces 0 and leaves a sliver of
# desktop inside every macOS corner; uniform is believed to apply one fixed
# radius to every window regardless of shape (untested here).
#
# Omarchy uses border_size = 2; 6.0 here because macOS draws the ring outside
# the window frame, where it is easier to lose against a busy wallpaper.
# THE GAPS IN aerospace.base.toml TRACK THIS NUMBER: outer = width,
# inner = twice it. Change the width and change those to match, or the ring
# is clipped off-screen on any edge flush with the display.
options=(
  style=round
  width=6.0
  hidpi=on
  active_color="gradient(top_left=0xff9580ff,bottom_right=0xff57c7ff)"
  # Omarchy dims unfocused windows with 0xaa595959. Transparent here instead,
  # so exactly one window on screen is ringed. Swap it in if you prefer theirs.
  inactive_color=0x00000000
)
borders "${options[@]}"
