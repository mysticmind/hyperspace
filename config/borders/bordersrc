#!/bin/bash
# JankyBorders — a thin ring around the focused window only.
# Launched by `brew services start borders`; this file is executed by the
# daemon on startup and messages the options across.
#
# Colours come from the Alacritty theme: 0xff9580ff is the cursor purple,
# 0xff57c7ff is its blue. Omarchy's own is brighter — cyan into green,
# rgba(33ccffee)/rgba(00ff99ee) in Hyprland order, which is
# gradient(top_left=0xee33ccff,bottom_right=0xee00ff99) here — but against a
# dark terminal it shouts where this one just reads.
#
# hidpi=on renders at native Retina resolution instead of a scaled 1x line.
# It is most of why this reads sharp at 3pt — a crisp thin edge looks
# stronger than a soft thick one.
#
# Omarchy uses border_size = 2; 4.0 here because macOS draws the ring outside
# the window frame, where it is easier to lose against a busy wallpaper.
options=(
  style=round                 # macOS windows are rounded; Omarchy's rounding=0 suits Linux
  width=4.0
  hidpi=on
  active_color="gradient(top_left=0xff9580ff,bottom_right=0xff57c7ff)"
  # Omarchy dims unfocused windows with 0xaa595959. Transparent here instead,
  # so exactly one window on screen is ringed. Swap it in if you prefer theirs.
  inactive_color=0x00000000
)
borders "${options[@]}"
