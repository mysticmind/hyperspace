#!/usr/bin/env python3
"""Render the keybinding cheatsheet FROM aerospace.toml.

Parsing the live config is the point: the sheet cannot drift from the keys it
documents, and any binding a plugin adds shows up here for free.

A trailing `# comment` on a binding line becomes its description; without one,
the AeroSpace command itself is shown.
"""
import os, pathlib, re, sys, shutil

CONFIG = pathlib.Path(os.environ.get(
    "HYPERSPACE_AEROSPACE_CONFIG", pathlib.Path.home()/".config/aerospace/aerospace.toml"))

MODS = [("cmd-ctrl-alt-shift-", "Super+Shift+"), ("cmd-ctrl-alt-", "Super+"),
        ("ctrl-alt-", "Ctrl+Alt+"), ("alt-shift-", "Alt+Shift+"), ("alt-", "Alt+")]
KEYS = {"enter": "Return", "minus": "-", "equal": "=", "esc": "Esc", "tab": "Tab",
        "space": "Space", "semicolon": ";", "comma": ",", "backspace": "⌫",
        "left": "←", "right": "→", "up": "↑", "down": "↓",
        "leftsquarebracket": "[", "rightsquarebracket": "]", "backslash": "\\",
        "slash": "/", "period": ".", "quote": "'", "backtick": "`"}


def pretty(binding):
    prefix = ""
    for raw, nice in MODS:
        if binding.startswith(raw):
            prefix, binding = nice, binding[len(raw):]
            break
    low = binding.lower()
    if low in KEYS:
        return prefix + KEYS[low]
    return prefix + (binding.upper() if len(binding) == 1 else binding.capitalize())


def collapse(rows):
    """1..9 workspace bindings are nine identical lines; show them as one."""
    out, seen = [], set()
    for key, desc in rows:
        m = re.match(r"^(Super(?:\+Shift)?\+)([1-9])$", key)
        if m:
            group = m.group(1)
            if group in seen:
                continue
            seen.add(group)
            key = f"{group}1..9"
            desc = re.sub(r"\b1\b", "N", desc)
        out.append((key, desc))
    return out


def parse(path):
    if not path.exists():
        sys.exit(f"no config at {path}")
    sections, current = {}, None
    for line in path.read_text().splitlines():
        s = line.strip()
        if s.startswith("[") and s.endswith("]"):
            current = s.strip("[]")
            continue
        if not current or "binding" not in current or "=" not in s or s.startswith("#"):
            continue
        key, _, rest = s.partition("=")
        key, rest = key.strip(), rest.strip()
        desc = None
        if "#" in rest:                      # trailing comment wins as the label
            cmd_part, _, comment = rest.rpartition("#")
            if cmd_part.strip():
                rest, desc = cmd_part.strip(), comment.strip()
        if desc is None:
            if rest.startswith("["):          # ['reload-config', 'mode main']
                desc = " + ".join(re.findall(r"'([^']*)'", rest))
            else:
                desc = rest.strip("'\"[] ")
            desc = re.sub(r"^exec-and-forget\s+", "", desc)
            desc = re.sub(r"\$HOME/[^\s']*/", "", desc)
        sections.setdefault(current, []).append((pretty(key), desc))
    return sections


KEYW, DESCW, GUTTER = 20, 30, 4
COLW = KEYW + DESCW + 2


def blocks(sections):
    """[(header, [(key, desc), ...]), ...] in a stable order."""
    order = ["mode.main.binding"] + [k for k in sections if k != "mode.main.binding"]
    out = []
    for sec in order:
        rows = sections.get(sec)
        if not rows:
            continue
        label = ("main" if sec == "mode.main.binding"
                 else sec.replace(".binding", "").replace("mode.", "") + " mode")
        out.append((label, collapse(rows)))
    return out


def render_lines(bs):
    """Flatten blocks into (plain, styled) line pairs, keeping headers attached."""
    lines = []
    for i, (label, rows) in enumerate(bs):
        if i:
            lines.append(("", ""))
        lines.append((label, f"\033[1;33m{label}\033[0m"))
        for key, desc in rows:
            k, d = key[:KEYW], desc[:DESCW]
            lines.append((f" {k:<{KEYW}} {d}", f" \033[1;37m{k:<{KEYW}}\033[0m {d}"))
    return lines


def layout(lines, columns=2):
    """Equal-height columns. Cutting only on blank lines leaves one column
    enormous when a single section dominates, so cut anywhere — just never
    directly after a section header, which would strand it at a column foot."""
    if columns < 2 or not lines:
        return [lines]
    while lines and lines[-1][0] == "":
        lines.pop()
    height = -(-len(lines) // columns)
    is_header = lambda i: 0 <= i < len(lines) and lines[i][0] and not lines[i][0].startswith(" ")
    cols, start = [], 0
    for c in range(columns):
        end = len(lines) if c == columns - 1 else min(start + height, len(lines))
        if c < columns - 1 and is_header(end - 1):
            end -= 1                      # push a trailing header into the next column
        chunk = lines[start:end]
        while chunk and chunk[0][0] == "":
            chunk.pop(0)                  # no leading blank at a column top
        cols.append(chunk)
        start = end
    return cols


def compose(sections, columns=2):
    cols = layout(render_lines(blocks(sections)), columns)
    height = max(len(c) for c in cols)
    out = []
    for r in range(height):
        parts = []
        for c in cols:
            plain, styled = c[r] if r < len(c) else ("", "")
            parts.append(styled + " " * (COLW + GUTTER - len(plain)))
        out.append("  " + "".join(parts).rstrip())
    return out


def main():
    sections = parse(CONFIG)

    # The native panel renders its own layout, so it wants the structure, not
    # the ANSI art. Same parse either way — there is still one source of truth
    # for what the bindings are.
    if "--json" in sys.argv:
        import json
        print(json.dumps([{"label": label,
                           "rows": [{"key": k, "desc": d} for k, d in rows]}
                          for label, rows in blocks(sections)]))
        return

    columns = 1 if "--one-column" in sys.argv else 2
    body = compose(sections, columns)
    title = "hyperspace — keybindings    (Super = Caps Lock)"
    width = max(len(l) for l in body) if body else 60

    if "--size" in sys.argv:
        # cols, lines — the toggle sizes the window from this, so the sheet
        # never scrolls and never leaves empty space.
        print(max(width, len(title) + 4) + 2, len(body) + 6)
        return

    print(f"\n  \033[1;36m{title}\033[0m")
    print("  " + "─" * (len(title) + 2))
    for line in body:
        print(line)
    print(f"\n  \033[2mSuper+K closes this.\033[0m")


if __name__ == "__main__":
    main()
