#!/usr/bin/env bash
# Super+Shift+K: the native plugin panel.
#
# Built on first run and cached, rather than compiled by install.sh: there is
# no build step to forget, no binary in the repo, and it rebuilds by itself
# whenever the source is newer than the cache.
#
# Without Xcode Command Line Tools there is no swiftc, so this falls back to
# plugin-dialog, which needs nothing but osascript. That is the only reason
# plugin-dialog still exists.
set -uo pipefail

HERE="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" || echo "${BASH_SOURCE[0]}")")" && pwd)"
SRC="$HERE/plugin-ui.swift"
CACHE="${XDG_STATE_HOME:-$HOME/.local/state}/hyperspace/plugin-ui"

# Super+Shift+K is a toggle, the same as Super+K is for the cheatsheet: a
# second press closes the panel instead of stacking another copy behind the
# first. Matched on the cache path, which is this binary's argv[0] and is not
# a substring of anything else — in particular not of this wrapper, which
# lives in the repo's bin/ under a different path.
if pids="$(pgrep -f "$CACHE" 2>/dev/null)" && [[ -n "$pids" ]]; then
  # shellcheck disable=SC2086
  kill $pids 2>/dev/null
  exit 0
fi

command -v swiftc >/dev/null 2>&1 || exec "$HERE/plugin-dialog"

if [[ ! -x "$CACHE" || "$SRC" -nt "$CACHE" ]]; then
  mkdir -p "$(dirname "$CACHE")"
  if ! swiftc -O -parse-as-library "$SRC" -o "$CACHE" 2>"$CACHE.log"; then
    echo "plugin-ui: build failed, see $CACHE.log" >&2
    exec "$HERE/plugin-dialog"
  fi
fi

exec "$CACHE" "$HERE/plugin"
