#!/usr/bin/env bash
# Super+K: show the cheatsheet, or close it if it is already up.
#
# Built on first run and cached, rather than compiled by install.sh: there is
# no build step to forget, no binary in the repo, and it rebuilds by itself
# whenever the source is newer than the cache.
#
# Without Xcode Command Line Tools there is no swiftc, so this falls back to
# cheatsheet-term, the Alacritty window this replaced. That path still works,
# it just has to predict its own size from font metrics to place itself; the
# native panel measures itself instead.
set -uo pipefail

AS="${AEROSPACE:-/opt/homebrew/bin/aerospace}"
HERE="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" || echo "${BASH_SOURCE[0]}")")" && pwd)"
SRC="$HERE/cheatsheet-ui.swift"
CACHE="${XDG_STATE_HOME:-$HOME/.local/state}/hyperspace/cheatsheet-ui"

# A toggle, not a launcher: a second press closes the sheet rather than
# stacking another copy behind the first. Matched on the cache path, which is
# this binary's argv[0] and is not a substring of anything else.
if pids="$(pgrep -f "$CACHE" 2>/dev/null)" && [[ -n "$pids" ]]; then
  # shellcheck disable=SC2086
  kill $pids 2>/dev/null
  exit 0
fi

# The Alacritty fallback owns its own toggle, including closing a sheet this
# script never opened, so hand over before doing anything else.
command -v swiftc >/dev/null 2>&1 || exec "$HERE/cheatsheet-term"

# An older install may have left a terminal sheet up. Close it so Super+K
# cannot leave two cheatsheets on screen at once.
if wid="$("$AS" list-windows --all --format '%{window-id}|%{window-title}' 2>/dev/null \
          | awk -F'|' '$2 == "hyperspace-cheatsheet" { print $1; exit }')" && [[ -n "$wid" ]]; then
  "$AS" close --window-id "$wid" 2>/dev/null
fi

if [[ ! -x "$CACHE" || "$SRC" -nt "$CACHE" ]]; then
  mkdir -p "$(dirname "$CACHE")"
  if ! swiftc -O -parse-as-library "$SRC" -o "$CACHE" 2>"$CACHE.log"; then
    echo "cheatsheet-ui: build failed, see $CACHE.log" >&2
    exec "$HERE/cheatsheet-term"
  fi
fi

exec "$CACHE" "$HERE/cheatsheet"
