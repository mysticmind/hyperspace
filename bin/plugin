#!/usr/bin/env python3
"""Manage hyperspace plugins.

    plugin list [--json]        what exists, and what is on
    plugin enable <name>...     turn on, rebuild the config, reload AeroSpace
    plugin disable <name>...    turn off, likewise

A plugin is a directory under plugins/ containing:

    plugin.toml        name + description                        (required)
                       network = true, if it makes requests       (optional)
    bindings.toml      [mode.main.binding] lines to splice in    (optional)
    window-rules.toml  [[on-window-detected]] blocks             (optional)
    swiftbar/          menu bar plugins, linked into ~/.config/swiftbar (optional)
    install.sh         run on enable                             (optional)
    uninstall.sh       run on disable                            (optional)

Nothing is enabled implicitly: dropping a directory into plugins/ does nothing
until you enable it, so a git pull cannot silently rebind your keyboard.

The core never touches the network. A plugin may, and must then declare
`network = true` in its plugin.toml - which this prints before enabling it,
tags in `list`, and tests/properties.sh enforces by failing on any fetcher
that was never declared.
"""
import json, pathlib, plistlib, subprocess, sys, time

REPO = pathlib.Path(__file__).resolve().parent.parent
PLUGINS = REPO/"plugins"
STATE = pathlib.Path.home()/".local/state/hyperspace/enabled-plugins"

def read_toml(path):
    """Read a plugin.toml without tomllib.

    tomllib arrived in python 3.11 and macOS ships 3.9.6, so importing it made
    `brew install python` a prerequisite of hyperspace - for two string fields.
    A plugin.toml is `key = "value"` lines and nothing else, so it is read here
    directly. tomllib is still preferred when the interpreter has it, so a
    plugin using anything fancier keeps working on a newer python.
    """
    text = path.read_text()
    try:
        import tomllib
        return tomllib.loads(text)
    except ModuleNotFoundError:
        pass
    # Refuse what this cannot parse, rather than returning something wrong.
    # A multi-line string parsed line-by-line yields a stray quote and looks
    # like a description, so it would be silently wrong on 3.9 and correct on
    # 3.11 - the worst kind of bug, one that only appears on someone else's
    # machine. Scalars and arrays degrade to strings, which is survivable
    # because only name and description are ever read; this is not.
    if '"""' in text or "\'\'\'" in text:
        raise ValueError(
            f"{path.name}: multi-line strings need python 3.11+ (this is "
            f"{'.'.join(str(v) for v in __import__('sys').version_info[:3])}). "
            "Use a single-line value.")

    out = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        # Checked BEFORE the "no = sign" skip below: a [section] header has no
        # equals in it, so testing for it after that skip never fired at all.
        # Flattening a section silently merges tables TOML keeps apart.
        if line.startswith("[") and line.endswith("]"):
            raise ValueError(
                f"{path.name}: [{line.strip('[]')}] sections need python 3.11+. "
                "Keep plugin.toml to top-level keys.")
        if "=" not in line:
            continue
        key, _, value = line.partition("=")
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
            # TOML escapes; the volume plugin's description contains one.
            value = value.replace('\\\\', '\\').replace('\\"', '"')
        out[key.strip()] = value
    return out

SWIFTBAR = pathlib.Path.home()/".config/swiftbar"
AEROSPACE = "/opt/homebrew/bin/aerospace"


def enabled():
    if not STATE.exists():
        return []
    return [l.strip() for l in STATE.read_text().splitlines() if l.strip() and not l.startswith("#")]


def write_enabled(names):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text("\n".join(sorted(set(names))) + "\n")


def meta(name):
    f = PLUGINS/name/"plugin.toml"
    if not f.exists():
        return {"name": name, "description": "(no plugin.toml)"}
    try:
        return read_toml(f)
    except Exception as e:
        return {"name": name, "description": f"(bad plugin.toml: {e})"}


def available():
    return sorted(d.name for d in PLUGINS.iterdir() if d.is_dir()) if PLUGINS.is_dir() else []


def declares_network(name):
    """Whether the plugin admits to making requests.

    hyperspace's own promise is that nothing touches the network at runtime,
    and that holds for the core. A plugin can legitimately need to - the
    worldradio plugin is a radio - so it says `network = true` in its
    plugin.toml, this prints it before enabling, and tests/properties.sh
    fails the build if anything fetches without having declared it.

    Accepts the string as well as the boolean: python 3.9 has no tomllib and
    the fallback parser in read_toml() returns every value as text.
    """
    value = meta(name).get("network")
    return value is True or str(value).strip().lower() == "true"


def swiftbar_undisable(paths):
    """SwiftBar keeps its OWN disabled list, keyed by resolved path, in
    com.ameba.SwiftBar. It is set from the menu bar and it outlives our
    symlink: we only ever managed ~/.config/swiftbar, so a plugin switched
    off there stayed dark no matter how often you re-enabled it here. That
    made disabling from the menu bar a one-way door. Clear our own entries
    so `enable` actually means enabled.

    SwiftBar caches preferences in memory and rewrites them when it quits, so
    a write behind its back is simply lost. It has to be stopped first - but
    only when there is really something to clear, which is almost never.
    """
    want = {str(pathlib.Path(p).resolve()) for p in paths}

    def disabled():
        try:
            r = subprocess.run(["defaults", "export", "com.ameba.SwiftBar", "-"],
                               capture_output=True)
            return plistlib.loads(r.stdout) if r.returncode == 0 else None
        except Exception:
            return None

    d = disabled()
    if d is None or not (set(d.get("DisabledPlugins") or []) & want):
        return

    was_running = subprocess.run(["pgrep", "-x", "SwiftBar"],
                                 capture_output=True).returncode == 0
    if was_running:
        subprocess.run(["osascript", "-e", 'tell application "SwiftBar" to quit'],
                       capture_output=True)
        time.sleep(2)

    d = disabled()          # re-read: quitting flushes SwiftBar's own copy
    if d is None:
        return
    d["DisabledPlugins"] = [x for x in (d.get("DisabledPlugins") or []) if x not in want]
    subprocess.run(["defaults", "import", "com.ameba.SwiftBar", "-"],
                   input=plistlib.dumps(d))
    print("  cleared SwiftBar's own disable (it had been switched off from the menu bar)")
    if was_running:
        subprocess.run(["open", "-a", "SwiftBar"], capture_output=True)


def link_swiftbar(name, on):
    d = PLUGINS/name/"swiftbar"
    if not d.is_dir():
        return
    SWIFTBAR.mkdir(parents=True, exist_ok=True)
    for f in d.iterdir():
        dst = SWIFTBAR/f.name
        if on:
            if dst.exists() and not dst.is_symlink():
                print(f"  skip {f.name}: a real file already exists there")
                continue
            dst.unlink(missing_ok=True)
            dst.symlink_to(f)
            print(f"  linked menu bar plugin {f.name}")
            swiftbar_undisable([f])
        elif dst.is_symlink() and dst.resolve() == f.resolve():
            dst.unlink()
            print(f"  unlinked menu bar plugin {f.name}")


def hook(name, script, assume_yes=False):
    """Run a plugin's install/uninstall hook, after saying so.

    This is the one place hyperspace executes code it did not write. A plugin
    is a directory someone can drop in, and its hook runs as you, with your
    permissions - the dictation plugin legitimately uses this to merge
    Karabiner rules. That is a reasonable thing for a plugin to do and an
    unreasonable thing to do silently, so the hook is named, its size shown,
    and on a terminal you get the chance to read it first.

    --yes skips the prompt, which is what the SwiftBar menu and the panel pass:
    a GUI toggle has no stdin to answer with. They are only ever enabling
    plugins already in the repo you cloned.
    """
    f = PLUGINS/name/script
    if not f.exists():
        return True
    # flush: the hook writes straight to the terminal, so an unflushed
    # announcement lands AFTER the thing it was meant to announce.
    print(f"  {name}/{script} will run as you ({f.stat().st_size} bytes)", flush=True)
    if not assume_yes and sys.stdin.isatty():
        try:
            a = input("  [r]un, [s]how it first, or [q]uit? ").strip().lower()
        except EOFError:
            a = "q"
        if a.startswith("s"):
            print()
            print(f.read_text().rstrip())
            print()
            try:
                a = input("  run it? [y/N] ").strip().lower()
            except EOFError:
                a = "n"
            if not a.startswith("y"):
                print("  skipped")
                return False
        elif a.startswith("q"):
            print("  skipped")
            return False
    subprocess.run(["/bin/bash", str(f)], check=False)
    return True


def announce_network(name, assume_yes=False):
    """Say that this plugin makes requests, before it is enabled.

    Returns False if the answer is no. The confirmation is asked only when
    there is no install.sh to ask about: that hook prompt comes immediately
    after this line and is the same decision, and being asked twice to enable
    one plugin teaches people to hit y without reading either.

    --yes skips it, as it does for hooks, because the SwiftBar menu and the
    panel have no stdin to answer with. They show the tag instead.
    """
    if not declares_network(name):
        return True
    print(f"  {name} declares network = true: it makes requests as you, when "
          f"you ask it to.", flush=True)
    print(f"  what it contacts is in plugins/{name}/ - read it before enabling.",
          flush=True)
    if assume_yes or not sys.stdin.isatty() or (PLUGINS/name/"install.sh").exists():
        return True
    try:
        return input("  enable it? [y/N] ").strip().lower().startswith("y")
    except EOFError:
        return False


def rebuild():
    """Returns True on success. Never leaves a broken config behind."""
    r = subprocess.run([str(REPO/"bin/build-config")], capture_output=True, text=True)
    print(r.stdout.strip() or r.stderr.strip())
    if r.returncode != 0:
        return False
    subprocess.run([AEROSPACE, "reload-config"], check=False)
    return True


def cmd_list(as_json=False):
    on = set(enabled())
    names = available()
    # --json is what the Swift panel reads, so it never has to parse TOML or
    # know where the state file lives. One source of truth for both front ends.
    if as_json:
        print(json.dumps([{"name": n,
                           "description": meta(n).get("description", ""),
                           "network": declares_network(n),
                           "enabled": n in on} for n in names]))
        return
    if not names:
        print("no plugins in plugins/")
        return
    for n in names:
        m = meta(n)
        mark = "\033[1;32m on\033[0m" if n in on else "\033[2moff\033[0m"
        # The network tag is on the listing, not only on the enable, so it is
        # visible before you decide rather than while it happens.
        tag = "  \033[2m[network]\033[0m" if declares_network(n) else ""
        print(f"  [{mark}] {n:<14} {m.get('description', '')}{tag}")


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__); return
    action, names = sys.argv[1], sys.argv[2:]
    assume_yes = "--yes" in names
    names = [n for n in names if n != "--yes"]
    if action == "list":
        cmd_list(as_json="--json" in names); return
    if action not in ("enable", "disable") or not names:
        sys.exit("usage: plugin (list|enable <name>...|disable <name>...)")

    have = available()
    for n in names:
        if n not in have:
            sys.exit(f"no such plugin: {n} (have: {', '.join(have) or 'none'})")

    cur = set(enabled())
    for n in names:
        if action == "enable":
            cur.add(n); print(f"enabling {n}")
            if not announce_network(n, assume_yes):
                cur.discard(n)
                print("  skipped")
                continue
            hook(n, "install.sh", assume_yes); link_swiftbar(n, True)
        else:
            cur.discard(n); print(f"disabling {n}")
            link_swiftbar(n, False); hook(n, "uninstall.sh", assume_yes)
    # Write state, then roll it back if the rebuild rejects the result - a
    # colliding plugin must not stay "enabled" and break every later build.
    previous = enabled()
    write_enabled(cur)
    if not rebuild():
        write_enabled(previous)
        for n in names:
            if action == "enable":
                link_swiftbar(n, False)
        print("rolled back - plugin state unchanged")
        sys.exit(1)


if __name__ == "__main__":
    main()
