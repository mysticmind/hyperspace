#!/usr/bin/env bash
# Diagnose the three layers a keybinding has to survive. Run it when a chord
# "does nothing" - the config is usually fine and the key is being eaten below.
#
#   1. macOS modifier mapping   - can consume Caps Lock before Karabiner sees it
#   2. Karabiner                - can read a config without applying it
#   3. AeroSpace                - binding registered, command works
#
# Usage: doctor [--fix]     (--fix clears a Caps Lock remap, with a backup)
set -uo pipefail

FIX=0; CAPS_ONLY=0; AUDIT=0
for a in "$@"; do
  case "$a" in
    --fix) FIX=1 ;;
    --caps-only) CAPS_ONLY=1 ;;   # layer 1 only: the other two need the stack installed
    --audit) AUDIT=1 ;;           # what hyperspace has changed on this machine
  esac
done
STATE="$HOME/.local/state/hyperspace"
CAPS_HID=30064771129          # 0x700000039 - Caps Lock
fail=0
ok()   { printf '  \033[1;32mok\033[0m    %s\n' "$*"; }
bad()  { printf '  \033[1;31mFAIL\033[0m  %s\n' "$*"; fail=1; }
warn() { printf '  \033[1;33mwarn\033[0m  %s\n' "$*"; }

# --audit answers a different question from the three layers: not "is it
# working" but "what has this done to my machine". Read entirely from the
# manifest, which is the same record uninstall.sh restores from, so what this
# prints IS what would be put back. A claim about reversibility that cannot be
# inspected is only a promise.
if (( AUDIT )); then
  MANIFEST="$STATE/manifest"
  if [[ ! -f "$MANIFEST" ]]; then
    echo "No manifest at $MANIFEST - hyperspace is not installed on this machine."
    exit 0
  fi
  echo "Everything hyperspace has changed here, and what uninstall.sh restores."
  echo "Source: $MANIFEST"
  echo

  echo "Symlinks it created (removed on uninstall):"
  n=0
  while IFS=$'\t' read -r kind dst _; do
    [[ "$kind" == "link" ]] || continue
    if [[ -L "$dst" ]]; then
      printf '  %s\n      -> %s\n' "${dst/#$HOME/\~}" "$(readlink "$dst")"
    else
      printf '  %s  (gone already)\n' "${dst/#$HOME/\~}"
    fi
    n=$((n+1))
  done < "$MANIFEST"
  (( n )) || echo "  (none)"
  echo

  echo "Files it displaced (moved back on uninstall):"
  n=0
  while IFS=$'\t' read -r kind dst bak; do
    [[ "$kind" == "backup" ]] || continue
    if [[ -e "$bak" ]]; then
      printf '  %s\n      backup: %s\n' "${dst/#$HOME/\~}" "${bak/#$HOME/\~}"
    else
      printf '  %s\n      \033[1;31mBACKUP MISSING\033[0m: %s\n' "${dst/#$HOME/\~}" "${bak/#$HOME/\~}"
    fi
    n=$((n+1))
  done < "$MANIFEST"
  (( n )) || echo "  (none - nothing of yours was in the way)"
  echo

  echo "Other people's symlinks it replaced (restored on uninstall):"
  n=0
  while IFS=$'\t' read -r kind dst prev; do
    [[ "$kind" == "prior-symlink" ]] || continue
    printf '  %s\n      was -> %s\n' "${dst/#$HOME/\~}" "$prev"
    n=$((n+1))
  done < "$MANIFEST"
  (( n )) || echo "  (none)"
  echo

  echo "Preferences it changed (set back on uninstall):"
  n=0
  while read -r kind domain key type val; do
    [[ "$kind" == "default" ]] || continue
    now="$(defaults read "$domain" "$key" 2>/dev/null || echo '<unset>')"
    if [[ "$type" == "ABSENT" ]]; then
      printf '  %s %s\n      now: %s   was: unset, so uninstall deletes it\n' "$domain" "$key" "$now"
    else
      printf '  %s %s\n      now: %s   was: %s (%s)\n' "$domain" "$key" "$now" "$val" "$type"
    fi
    n=$((n+1))
  done < "$MANIFEST"
  (( n )) || echo "  (none)"
  echo

  echo "Login agents it installed (removed on uninstall):"
  n=0
  for f in "$HOME/Library/LaunchAgents"/com.hyperspace.*.plist; do
    [[ -e "$f" ]] || continue
    printf '  %s\n' "${f/#$HOME/\~}"
    n=$((n+1))
  done
  (( n )) || echo "  (none)"
  echo

  echo "Not recorded because it is never touched: your shell config, and every"
  echo "Homebrew package. uninstall.sh prints the brew commands, never runs them."
  exit 0
fi

echo "1. macOS modifier mapping"
mapped=0
for key in $(defaults -currentHost read -g 2>/dev/null \
             | grep -o 'com\.apple\.keyboard\.modifiermapping\.[0-9-]*' | sort -u); do
  val="$(defaults -currentHost read -g "$key" 2>/dev/null)"
  if grep -q "MappingSrc = $CAPS_HID" <<<"$val"; then
    dst="$(grep -o 'MappingDst = [0-9]*' <<<"$val" | head -1 | awk '{print $3}')"
    bad "$key remaps Caps Lock (Src $CAPS_HID -> Dst $dst)"
    echo "        Karabiner's 'from: caps_lock' can never match - the key is"
    echo "        consumed before Karabiner sees it, so EVERY binding is dead."
    mapped=1
    if (( FIX )); then
      mkdir -p "$STATE"
      defaults -currentHost read -g "$key" > "$STATE/modifiermapping.backup" 2>/dev/null
      defaults -currentHost delete -g "$key" 2>/dev/null \
        && echo "        cleared (backup: $STATE/modifiermapping.backup)"
      killall cfprefsd 2>/dev/null || true
    fi
    echo "        Apply it live: System Settings -> Keyboard -> Keyboard"
    echo "        Shortcuts... -> Modifier Keys -> Caps Lock = 'Caps Lock' -> Done"
    echo "        (deleting the preference alone does not retract it from the"
    echo "        running session; the UI step or a logout does)"
  fi
done
(( mapped )) || ok "Caps Lock is not remapped by macOS"

if (( CAPS_ONLY )); then exit $fail; fi

echo "2. Karabiner"
CFG="$HOME/.config/karabiner/karabiner.json"
if [[ -f "$CFG" ]] && grep -q "Caps Lock -> Super" "$CFG"; then
  ok "the Caps Lock -> Super rule is in karabiner.json"
else
  bad "no Caps Lock -> Super rule in $CFG - run install.sh"
fi
KLOG="$HOME/.local/share/karabiner/log/console_user_server.log"
if [[ -f "$KLOG" ]]; then
  # A "Load ...json" with no "core_configuration is updated" after it means the
  # file was read but never applied.
  if [[ "$(grep -E 'Load .*karabiner\.json|core_configuration is updated' "$KLOG" | tail -1)" == *"core_configuration is updated"* ]]; then
    ok "Karabiner applied its config"
  else
    bad "Karabiner READ the config but never applied it. Restart the agents:"
    echo "        launchctl kickstart -k gui/\$(id -u)/org.pqrs.service.agent.Karabiner-Core-Service-rev2"
    echo "        launchctl kickstart -k gui/\$(id -u)/org.pqrs.service.agent.Karabiner-Console-User-Server"
  fi
fi

echo "3. AeroSpace"
AS="$(command -v aerospace || echo /opt/homebrew/bin/aerospace)"
if ! "$AS" list-workspaces --focused >/dev/null 2>&1; then
  bad "AeroSpace is not responding - is it running?"
else
  ok "AeroSpace is running"
  mode="$("$AS" list-modes --current 2>/dev/null)"
  if [[ "$mode" == "main" ]]; then ok "binding mode is 'main'"
  else bad "binding mode is '$mode' - main bindings are inactive; press Esc"; fi
  if "$AS" config --get mode.main.binding --keys 2>/dev/null | grep -q '^cmd-ctrl-alt-e$'; then
    ok "bindings are registered (cmd-ctrl-alt-e found)"
  else
    bad "bindings not registered - run: aerospace reload-config"
  fi
fi

echo
if (( fail )); then
  echo "Something above is broken. Note that a correct config proves nothing:"
  echo "all three layers have to work for a chord to reach AeroSpace."
  exit 1
fi
echo "All three layers healthy. If a chord still does nothing:"
echo
echo "  - Check no other app claims it, and that focus is on a TILED window"
echo "    (layout commands no-op on floating ones)."
echo
echo "  - The stack can be WEDGED while still reporting healthy. Every check"
echo "    above reads config and process state; none of them proves a key"
echo "    actually travels. A running Karabiner that has lost its grip, or an"
echo "    AeroSpace that has not recomputed screen geometry, passes all three"
echo "    and still eats every chord. Restart them:"
echo
echo "      hyperspace-restart"
echo
echo "    or, if Super itself is dead so no chord can reach this, the same"
echo "    thing is in the SwiftBar menu under Restart Karabiner + AeroSpace."
echo "    AeroSpace needs a RESTART and not a reload after anything changes the"
echo "    menu bar or Dock - it does not recompute the screen on its own."
